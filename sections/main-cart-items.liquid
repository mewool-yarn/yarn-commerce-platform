{%- comment -%}
  购物车整页（Issue #124，Claude Design「购物车」Cart.dc.html：手机 1a / 1d，桌面 2a / 2b）。
  条目、小计与结账都在本 section：cart.js 按 #main-cart-items / #main-cart-footer / #YarnCartCount 局部刷新。
  空购物车的入口按钮、新手卡与帮助条是运营文案，链接为空时不渲染。
{%- endcomment -%}
{{ 'yarn-cart.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

{%- comment -%} 抽屉不在购物车页渲染，所以本页总是自己加载 cart.js（cart-drawer.js 也依赖它）。 {%- endcomment -%}
<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

{%- liquid
  capture empty_text
    render 'yarn-setting-text', settings: section.settings, key: 'empty_text'
  endcapture
  capture projects_label
    render 'yarn-setting-text', settings: section.settings, key: 'projects_label'
  endcapture
  capture yarn_label
    render 'yarn-setting-text', settings: section.settings, key: 'yarn_label'
  endcapture
  capture beginner_heading
    render 'yarn-setting-text', settings: section.settings, key: 'beginner_heading'
  endcapture
  capture beginner_text
    render 'yarn-setting-text', settings: section.settings, key: 'beginner_text'
  endcapture
  capture help_heading
    render 'yarn-setting-text', settings: section.settings, key: 'help_heading'
  endcapture
  capture help_label
    render 'yarn-setting-text', settings: section.settings, key: 'help_label'
  endcapture

  assign show_projects = false
  if section.settings.projects_link != blank and projects_label != blank
    assign show_projects = true
  endif
  assign show_yarn = false
  if section.settings.yarn_link != blank and yarn_label != blank
    assign show_yarn = true
  endif
  assign show_beginner = false
  if section.settings.beginner_link != blank and beginner_heading != blank
    assign show_beginner = true
  endif
-%}

{%- capture help_strip -%}
  {%- if section.settings.help_link != blank and help_heading != blank -%}
    <a class="yarn-cart-help" href="{{ section.settings.help_link }}">
      <span class="yarn-cart-help__title">{{ help_heading | escape }}</span>
      {%- if help_label != blank -%}
        <span class="yarn-cart-help__action">{{ help_label | escape }}<span aria-hidden="true">→</span></span>
      {%- endif -%}
    </a>
  {%- endif -%}
{%- endcapture -%}

<cart-items
  class="yarn-cart color-{{ section.settings.color_scheme }} gradient{% if cart == empty %} is-empty{% endif %}"
  view-event-payload="{{ cart | standard_event_data: 'view', context: 'page' | escape }}"
>
  <div class="yarn-cart__filled">
    <div class="yarn-cart__head">
      <h1 class="yarn-cart__title">{{ 'yarn_cart.title' | t }}</h1>
      <span class="yarn-cart__count" id="YarnCartCount">{{ 'yarn_cart.item_count' | t: count: cart.item_count }}</span>
    </div>

    <div class="yarn-cart__layout">
      <div class="yarn-cart__main">
        <form action="{{ routes.cart_url }}" class="yarn-cart__form" method="post" id="cart">
          <div class="yarn-cart__items" id="main-cart-items" data-id="{{ section.id }}">
            <div class="js-contents">
              {%- if cart != empty -%}
                <div class="yarn-cart__labels" aria-hidden="true">
                  <span>{{ 'yarn_cart.heading_product' | t }}</span>
                  <span>{{ 'yarn_cart.heading_quantity' | t }}</span>
                  <span>{{ 'yarn_cart.heading_total' | t }}</span>
                </div>
                <ul class="yarn-cart-lines" role="list" aria-label="{{ 'yarn_cart.title' | t }}">
                  {%- for item in cart.items -%}
                    {%- render 'yarn-cart-line', item: item, context: 'page' -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </div>

          <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
          <p class="visually-hidden" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">
            {{ 'accessibility.loading' | t }}
          </p>
        </form>

        <a class="yarn-cart__continue-link" href="{{ routes.all_products_collection_url }}">
          {{- 'general.continue_shopping' | t -}}<span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="yarn-cart__aside">
        <div class="yarn-cart__summary" id="main-cart-footer" data-id="{{ section.id }}">
          <h2 class="visually-hidden">{{ 'yarn_cart.summary_heading' | t }}</h2>
          <div class="js-contents">
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul class="yarn-cart__discounts" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li>
                    {{- 'icon-discount.svg' | inline_asset_content -}}
                    {{ discount.title | escape }} (-{{ discount.total_allocated_amount | money }})
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <div class="yarn-cart__subtotal">
              <span>{{ 'yarn_cart.subtotal' | t: count: cart.item_count }}</span>
              <span class="yarn-cart__subtotal-price">{{ cart.total_price | money }}</span>
            </div>
            <p class="yarn-cart__tax">
              {%- if cart.duties_included and cart.taxes_included -%}
                {%- if shop.shipping_policy.body == blank -%}
                  {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
                {%- else -%}
                  {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              {%- elsif cart.duties_included == false and cart.taxes_included -%}
                {%- if shop.shipping_policy.body == blank -%}
                  {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
                {%- else -%}
                  {{ 'sections.cart.taxes_included_shipping_at_checkout_with_policy_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              {%- elsif cart.duties_included and cart.taxes_included == false -%}
                {%- if shop.shipping_policy.body == blank -%}
                  {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                {%- else -%}
                  {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              {%- else -%}
                {%- if shop.shipping_policy.body == blank -%}
                  {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                {%- else -%}
                  {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              {%- endif -%}
            </p>
          </div>

          {%- if settings.show_cart_note -%}
            <cart-note class="yarn-cart__note">
              <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
              <textarea name="note" form="cart" id="Cart-note" placeholder="{{ 'sections.cart.note' | t }}">{{ cart.note }}</textarea>
            </cart-note>
          {%- endif -%}

          <button
            type="submit"
            id="checkout"
            class="yarn-cart__checkout"
            name="checkout"
            form="cart"
            {% if cart == empty %}
              disabled
            {% endif %}
          >
            {{ 'yarn_cart.checkout' | t }}
          </button>

          {%- if additional_checkout_buttons -%}
            <div class="yarn-cart__dynamic additional-checkout-buttons">
              {{ content_for_additional_checkout_buttons }}
            </div>
          {%- endif -%}

          <div id="cart-errors" class="yarn-cart__errors"></div>

          <a class="yarn-cart__continue-button" href="{{ routes.all_products_collection_url }}">
            {{- 'general.continue_shopping' | t -}}
          </a>
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
        {%- endfor -%}

        {{ help_strip }}
      </div>
    </div>
  </div>

  <div class="yarn-cart__empty">
    <div class="yarn-cart__band">
      <span class="yarn-cart__cat" aria-hidden="true"></span>
      <h1 class="yarn-cart__empty-title">{{ 'yarn_cart.empty_title' | t }}</h1>
      {%- if empty_text != blank -%}
        <p class="yarn-cart__empty-text">{{ empty_text | escape }}</p>
      {%- endif -%}
      {%- if show_projects or show_yarn -%}
        <div class="yarn-cart__empty-actions">
          {%- if show_projects -%}
            <a class="yarn-cart__button yarn-cart__button--primary" href="{{ section.settings.projects_link }}">{{ projects_label | escape }}</a>
          {%- endif -%}
          {%- if show_yarn -%}
            <a class="yarn-cart__button {% if show_projects %}yarn-cart__button--secondary{% else %}yarn-cart__button--primary{% endif %}" href="{{ section.settings.yarn_link }}">{{ yarn_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if show_beginner or help_strip != blank -%}
      <div class="yarn-cart__empty-more">
        {%- if show_beginner -%}
          <a class="yarn-cart-beginner" href="{{ section.settings.beginner_link }}">
            <span class="yarn-cart-beginner__icon" aria-hidden="true">{{- 'icon-sprout.svg' | inline_asset_content -}}</span>
            <span class="yarn-cart-beginner__copy">
              <span class="yarn-cart-beginner__title">{{ beginner_heading | escape }}</span>
              {%- if beginner_text != blank -%}
                <span class="yarn-cart-beginner__text">{{ beginner_text | escape }}</span>
              {%- endif -%}
            </span>
            <span class="yarn-cart-beginner__arrow" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          </a>
        {%- endif -%}
        {{ help_strip }}
      </div>
    {%- endif -%}
  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "header", "content": "空购物车" },
    { "type": "textarea", "id": "empty_text", "label": "说明 · 日文", "default": "何を編むか決まっていなくても大丈夫。まずは毛糸をのぞいてみてください。" },
    { "type": "textarea", "id": "empty_text_zh", "label": "说明 · 中文", "default": "还没决定织什么？可以先看看毛线。" },
    { "type": "textarea", "id": "empty_text_en", "label": "说明 · 英文", "default": "Not sure what to make yet? Start by browsing our yarn." },
    { "type": "url", "id": "projects_link", "label": "主按钮链接（作品库）", "info": "留空则不显示主按钮" },
    { "type": "text", "id": "projects_label", "label": "主按钮 · 日文", "default": "作品から選ぶ" },
    { "type": "text", "id": "projects_label_zh", "label": "主按钮 · 中文", "default": "按作品图选" },
    { "type": "text", "id": "projects_label_en", "label": "主按钮 · 英文", "default": "Shop by project" },
    { "type": "url", "id": "yarn_link", "label": "毛线按钮链接", "info": "留空则不显示" },
    { "type": "text", "id": "yarn_label", "label": "毛线按钮 · 日文", "default": "毛糸をすべて見る" },
    { "type": "text", "id": "yarn_label_zh", "label": "毛线按钮 · 中文", "default": "看全部毛线" },
    { "type": "text", "id": "yarn_label_en", "label": "毛线按钮 · 英文", "default": "Browse all yarn" },
    { "type": "url", "id": "beginner_link", "label": "新手卡链接", "info": "留空则不显示新手卡" },
    { "type": "text", "id": "beginner_heading", "label": "新手卡标题 · 日文", "default": "はじめての方はこちらから" },
    { "type": "text", "id": "beginner_heading_zh", "label": "新手卡标题 · 中文", "default": "第一次织？从这里开始" },
    { "type": "text", "id": "beginner_heading_en", "label": "新手卡标题 · 英文", "default": "New to knitting? Start here" },
    { "type": "text", "id": "beginner_text", "label": "新手卡说明 · 日文" },
    { "type": "text", "id": "beginner_text_zh", "label": "新手卡说明 · 中文" },
    { "type": "text", "id": "beginner_text_en", "label": "新手卡说明 · 英文" },
    { "type": "header", "content": "帮助条" },
    { "type": "url", "id": "help_link", "label": "链接", "info": "留空则不显示帮助条" },
    { "type": "text", "id": "help_heading", "label": "标题 · 日文", "default": "材料選びに迷ったら" },
    { "type": "text", "id": "help_heading_zh", "label": "标题 · 中文", "default": "选材料拿不准？" },
    { "type": "text", "id": "help_heading_en", "label": "标题 · 英文", "default": "Need help choosing materials?" },
    { "type": "text", "id": "help_label", "label": "链接文字 · 日文", "default": "相談する" },
    { "type": "text", "id": "help_label_zh", "label": "链接文字 · 中文", "default": "问问我们" },
    { "type": "text", "id": "help_label_en", "label": "链接文字 · 英文", "default": "Ask us" }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
